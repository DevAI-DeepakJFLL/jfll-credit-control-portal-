# Version control
.git/
.gitignore
.github/

# Python virtual environment and bytecode
backend/venv/
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Frontend dependencies and builds
frontend/node_modules/
frontend/dist/
.npm/

# Local databases and runtime storage
backend/storage/*.db
backend/storage/*.db-shm
backend/storage/*.db-wal
backend/storage/uploads/*
backend/storage/memos/*
!backend/storage/uploads/.gitkeep
!backend/storage/memos/.gitkeep

# Environment files
.env
.env.*
!.env.example

# OS artifacts
.DS_Store
Thumbs.db
