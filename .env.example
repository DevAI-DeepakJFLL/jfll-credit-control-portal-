# ==============================================================================
# Jet Freight Logistics Credit Control Portal - Environment Template
# ==============================================================================

# AWS Deployment Region (Default: ap-southeast-2 or ap-south-1)
AWS_REGION=ap-southeast-2

# S3 Persistence Buckets (AWS Free Tier)
# S3_DATA_BUCKET stores persistent appraisals.db and generated CAM memos
S3_DATA_BUCKET=jfll-credit-portal-data
# S3_FRONTEND_BUCKET stores the compiled React Vite SPA bundle
S3_FRONTEND_BUCKET=jfll-credit-portal-frontend

# AWS Lambda Function Name for Mangum API backend
LAMBDA_FUNCTION_NAME=jfll-credit-portal-api

# Optional CloudFront CDN Distribution ID for caching & global delivery
CLOUDFRONT_DISTRIBUTION_ID=

# API Base URL for Frontend (leave blank if running behind CloudFront / Nginx)
VITE_API_BASE_URL=

# CORS Allowed Origins (comma-separated, default: * for stateless public API)
ALLOWED_ORIGINS=*

# Local storage paths (defaults to backend/storage locally, or /tmp in Lambda)
STORAGE_DIR=backend/storage
